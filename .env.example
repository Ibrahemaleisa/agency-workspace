# Postgres connection string (POSTGRES_URL is also accepted)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agency
# Local file storage folder (used when BLOB_READ_WRITE_TOKEN is not set)
UPLOAD_DIR=./uploads
# Set on Vercel: enables private Vercel Blob storage for uploads
# BLOB_READ_WRITE_TOKEN=
# Public demo only: "/" becomes the product landing page and visitors try the system in a private
# copy of the sample agency at /try, with no sign-in (never set this on a customer)
# SHOW_DEMO_ACCOUNTS=true

# ---- Email notifications (optional; without these, notifications are in-app only) ----
# Option A — Resend (https://resend.com): an API key + a sender on a domain you verified there
# RESEND_API_KEY=
# Option B — any SMTP server, e.g. Gmail with an App Password (smtp.gmail.com, port 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# Sender shown in emails (defaults to SMTP_USER)
# EMAIL_FROM="Your Agency <no-reply@youragency.com>"
# Public site URL for links in emails (auto-detected on Vercel)
# APP_URL=https://app.youragency.com

# Sent by Vercel Cron to /api/cron/* (daily cleanup; demo reset)
# CRON_SECRET=

# Terms of Service / Privacy Policy details (/terms, /privacy)
# LEGAL_ENTITY_NAME=Your Business Name
# LEGAL_CONTACT_EMAIL=privacy@example.com
# LEGAL_JURISDICTION=the Kingdom of Saudi Arabia
# LEGAL_EFFECTIVE_DATE=2026-10-12

# Post unexpected server errors to a Slack / Discord / Teams incoming webhook
# ALERT_WEBHOOK_URL=
