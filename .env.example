# Postgres connection string (POSTGRES_URL is also accepted)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agency
# Local file storage folder (used when BLOB_READ_WRITE_TOKEN is not set)
UPLOAD_DIR=./uploads
# Set on Vercel: enables private Vercel Blob storage for uploads
# BLOB_READ_WRITE_TOKEN=
# Show the demo accounts box on the login page in production
# SHOW_DEMO_ACCOUNTS=true

# ---- Email notifications (optional; without these, notifications are in-app only) ----
# Option A — Resend (https://resend.com): an API key + a sender on a domain you verified there
# RESEND_API_KEY=
# Option B — any SMTP server, e.g. Gmail with an App Password (smtp.gmail.com, port 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# Sender shown in emails (defaults to SMTP_USER)
# EMAIL_FROM="Your Agency <no-reply@youragency.com>"
# Public site URL for links in emails (auto-detected on Vercel)
# APP_URL=https://app.youragency.com

# ======================================================================
# Operra platform mode (multi-tenant SaaS). Leave unset for a single-agency deployment.
# Full guide: DEPLOYMENT.md
# ======================================================================
# OPERRA_PLATFORM=true
# APP_URL=https://app.operra.com
# 32+ random characters (openssl rand -base64 48). Required in production.
# APP_SECRET=
# Tenants at {slug}.operra.com (needs the wildcard domain on Vercel). Unset: APP_URL/w/{slug}
# APP_ROOT_DOMAIN=operra.com
# Sent by Vercel Cron to /api/cron/cleanup
# CRON_SECRET=
# Create the read-only /preview tenant on build (safe: touches only the "demo" tenant)
# SEED_PREVIEW=true
# Where the Operra logo on sign-up / preview links to
# MARKETING_URL=https://operra.com

# ---- Billing ----
# stripe | test   (test = clearly labelled fake checkout; refused in production unless ALLOW_TEST_BILLING=true)
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# One Stripe Price ID per plan code: STRIPE_PRICE_<CODE>
# STRIPE_PRICE_WORKSPACE=
# ALLOW_TEST_BILLING=false

# ---- Operra staff (control center) — used only by: npm run platform:admin -- <email> <name> ----
# PLATFORM_ADMIN_PASSWORD=
