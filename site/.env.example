# Public URL of the marketing site (canonical URLs, sitemap, Open Graph). Auto-detected on Vercel.
# NEXT_PUBLIC_SITE_URL=https://operra.example

# Live demo workspace linked from the site (defaults to the workspace-demo deployment)
# NEXT_PUBLIC_DEMO_URL=https://workspace-demo-sooty.vercel.app

# Shown on Contact and in the footer when set
# NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Where "Start free trial" and "Contact" submissions go (configure at least one in production) ----
# Email: the inbox that receives submissions, plus Resend OR SMTP
# INQUIRY_TO=sales@example.com
# RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Operra website <no-reply@example.com>"
# And/or a webhook that receives JSON (Slack incoming webhook, Zapier, Make, a CRM…)
# INQUIRY_WEBHOOK_URL=
